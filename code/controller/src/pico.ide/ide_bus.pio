.program ide_strobe_dior
.wrap_target
    wait 0 gpio 16      ; Attende che DIOR# vada basso
    nop [3]             ; Ritardo di ~32ns a 125MHz per assestamento linee A0-A2
    in pins, 7          ; Campiona i pin
    push block
    irq 0
    wait 1 gpio 16
.wrap

.program ide_strobe_diow
.wrap_target
    wait 0 gpio 17      ; Attende che DIOW# vada basso
    nop [3]             ; Ritardo di ~32ns
    in pins, 7
    push block
    irq 0
    wait 1 gpio 17
.wrap